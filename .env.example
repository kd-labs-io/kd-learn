# kd-learn server settings for Docker Compose. Copy to .env and fill in; never commit .env.
# Every variable: docs/deploy.md.

# --- Accounts (required for accounts; without it only guest mode runs) ---
# Encrypts provider keys at rest. 32 bytes in base64: `openssl rand -base64 32`.
# Keep a copy: losing it makes every saved provider key unreadable.
KD_LEARN_SECRET_KEY=

# The first admin, created on the first request when no admin exists yet.
# Password: 8 characters or more. You may remove both lines once the admin exists.
KD_LEARN_ADMIN_EMAIL=
KD_LEARN_ADMIN_PASSWORD=

# --- Defaults the admin screen can change later (stored in the DB after the first start) ---
# Registration: open, invite or closed.
KD_LEARN_REGISTRATION=invite
# Guest mode (own key, sessions on the device) and demo mode (server's key, shared budget).
KD_LEARN_GUEST_MODE=on
KD_LEARN_DEMO_MODE=off

# --- Demo model (all three or none; the key is the server's own) ---
# KD_LEARN_DEMO_PROVIDER=anthropic
# KD_LEARN_DEMO_MODEL=claude-haiku-5-5
# KD_LEARN_DEMO_API_KEY=
# Model calls per period for all demo users together (0 closes the demo); day, month or none.
# KD_LEARN_DEMO_BUDGET=200
# KD_LEARN_DEMO_BUDGET_PERIOD=day

# --- Network ---
# Behind a reverse proxy that sets X-Forwarded-For (needed for per-address rate limits).
KD_LEARN_TRUST_PROXY=1
# Extra origins allowed to call the API (the mobile app), comma separated.
# KD_CORS_ORIGINS=
# OpenAI-compatible endpoints learners may pick, JSON array:
# KD_OPENAI_COMPATIBLE_ENDPOINTS=[{"id":"local","label":"Local model","baseURL":"http://ollama:11434/v1"}]

# --- Compose only (read by docker-compose.yml, not by the server) ---
# KD_LEARN_BIND=127.0.0.1
# KD_LEARN_PORT=3000
